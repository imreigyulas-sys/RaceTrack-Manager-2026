[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://MainUI.gd" id="1_script"]
[ext_resource type="Script" path="res://GameManager.gd" id="2_manager"]

[node name="MainUI" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="GameManager" type="Node" parent="."]
script = ExtResource("2_manager")

[node name="VBoxContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -250.0
offset_right = 200.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 20

[node name="LblMoney" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "💰 Pénz: $350,000 | Hírnév: 50"
horizontal_alignment = 1

[node name="LblStats" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "📅 Év: 2026 | Verseny: 1/12"
horizontal_alignment: 1

[node name="BtnRace" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "🏁 Következő Verseny Futtatása"

[node name="BtnUpgradeSafety" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "🛡️ Biztonság Fejlesztése ($40,000)"

[node name="BtnUpgradeStand" type="Button" parent="VBoxContainer"]
layout_mode = 2
text = "🎟️ Lelátó Fejlesztése ($50,000)"

[node name="LblInfo" type="Label" parent="VBoxContainer"]
layout_mode = 2
text = "Üdv a pályán! Kezdd el a szezont."
horizontal_alignment = 1
autowrap_mode = 2

[connection signal="pressed" from="VBoxContainer/BtnRace" to="." method="_on_btn_race_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnUpgradeSafety" to="." method="_on_btn_upgrade_safety_pressed"]
[connection signal="pressed" from="VBoxContainer/BtnUpgradeStand" to="." method="_on_btn_upgrade_stand_pressed"]